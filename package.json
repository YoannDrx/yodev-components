{
  "name": "yodev-components",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "catalog:sync": "tsx scripts/sync-upstream.ts",
    "catalog:check": "tsx scripts/check-catalog.ts",
    "generate:ports": "tsx scripts/generate-ports.ts",
    "capture:thumbnails": "tsx scripts/capture-thumbnails.ts"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.2",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
